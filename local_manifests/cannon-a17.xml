<?xml version="1.0" encoding="UTF-8"?>
<!--
  cannon A17 (LineageOS 24.0 / Android 17) 单一 local_manifest —— 全 fork 单轨

  设计（2026-11-11 起）：
    - 所有需要本地修复的 project 一律指向 top-android fork 的 cannon-a17 分支，
      repo sync 出来的树即带全部修复，不再依赖 repro/patches/a17 的 build-time apply。
    - 与锁定清单（manifests/a17-pinned-*.xml）配合使用：pinned 提供全 SHA 基线，
      本文件用 remove-project + project 覆盖其中需要 fork 的条目；未列出的项目仍按
      pinned 的 SHA checkout，保证可复现。
    - 上游 LineageOS 前进时：在各 fork 的 cannon-a17 上 rebase，再重新导出 pinned 清单。

  remote 说明：
    github  fetch=".."                 → https://github.com/<name>（pinned 清单同款）
    devs    fetch="https://github.com" → https://github.com/<name>
    top-ssh fetch="ssh://git@github.com/top-android" → 私有签名密钥仓
-->
<manifest>
    <remote name="devs" fetch="https://github.com" />
    <remote name="top-ssh" fetch="ssh://git@github.com/top-android" />

    <!-- ============ 1) 已 fork 到 top-android 的 AOSP/LineageOS 项目 ============ -->
    <remove-project name="LineageOS/android_art" />
    <project path="art" name="top-android/android_art" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_build" />
    <project path="build/make" name="top-android/android_build" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_build_soong" />
    <project path="build/soong" name="top-android/android_build_soong" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_frameworks_base" />
    <project path="frameworks/base" name="top-android/android_frameworks_base" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_frameworks_native" />
    <project path="frameworks/native" name="top-android/android_frameworks_native" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_frameworks_opt_telephony" />
    <project path="frameworks/opt/telephony" name="top-android/android_frameworks_opt_telephony" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_hardware_lineage_compat" />
    <project path="hardware/lineage/compat" name="top-android/android_hardware_lineage_compat" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_hardware_nxp_secure_element" />
    <project path="hardware/nxp/secure_element" name="top-android/android_hardware_nxp_secure_element" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_hardware_xiaomi" />
    <project path="hardware/xiaomi" name="top-android/android_hardware_xiaomi" remote="devs" revision="cannon-a17" />

    <remove-project name="LineageOS/android_packages_apps_Jelly" />
    <project path="packages/apps/Jelly" name="top-android/android_packages_apps_Jelly" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_packages_apps_Launcher3" />
    <project path="packages/apps/Launcher3" name="top-android/android_packages_apps_Launcher3" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_packages_apps_Settings" />
    <project path="packages/apps/Settings" name="top-android/android_packages_apps_Settings" remote="github" revision="cannon-a17" />

    <remove-project name="platform/packages/modules/NetworkStack" />
    <project path="packages/modules/NetworkStack" name="top-android/android_packages_modules_NetworkStack" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_packages_providers_MediaProvider" />
    <project path="packages/providers/MediaProvider" name="top-android/android_packages_providers_MediaProvider" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_system_core" />
    <project path="system/core" name="top-android/android_system_core" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_system_netd" />
    <project path="system/netd" name="top-android/android_system_netd" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_system_sepolicy" />
    <project path="system/sepolicy" name="top-android/android_system_sepolicy" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_vendor_lineage" />
    <project path="vendor/lineage" name="top-android/android_vendor_lineage" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_packages_modules_Bluetooth" />
    <project path="packages/modules/Bluetooth" name="top-android/android_packages_modules_Bluetooth" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_packages_modules_Connectivity" />
    <project path="packages/modules/Connectivity" name="top-android/android_packages_modules_Connectivity" remote="github" revision="cannon-a17" />

    <remove-project name="LineageOS/android_system_bpf" />
    <project path="system/bpf" name="top-android/android_system_bpf" remote="github" revision="cannon-a17" />

    <!-- ============ 2) 设备/内核/厂商仓（自有，cannon-a17 或既有分支） ============ -->
    <remove-project name="top-android/android_device_xiaomi_cannon" />
    <project path="device/xiaomi/cannon" name="top-android/android_device_xiaomi_cannon" remote="devs" revision="cannon-a17" />

    <remove-project name="top-android/android_vendor_xiaomi_cannon" />
    <project path="vendor/xiaomi/cannon" name="top-android/android_vendor_xiaomi_cannon" remote="devs" revision="cannon-a17" />

    <!-- kernel / hardware-mediatek / wlan / Wifi / sepolicy_vndr 已由 pinned 清单钉在
         对应 fork 的 SHA 上（工作树干净），这里不重复定义，避免 duplicate path。 -->

    <!-- ============ 3) 私有签名/AVB key 由 pinned 清单定义（top-ssh + 固定 SHA），此处不重复 -->
</manifest>