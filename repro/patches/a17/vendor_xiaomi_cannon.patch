diff --git a/proprietary/vendor/etc/init/android.hardware.media.c2@1.2-mediatek.rc b/proprietary/vendor/etc/init/android.hardware.media.c2@1.2-mediatek.rc
index 8c51f2f..633ad4e 100644
--- a/proprietary/vendor/etc/init/android.hardware.media.c2@1.2-mediatek.rc
+++ b/proprietary/vendor/etc/init/android.hardware.media.c2@1.2-mediatek.rc
@@ -4,4 +4,7 @@ service android-hardware-media-c2-hal-1-2 /vendor/bin/hw/android.hardware.media.
     group camera drmrpc mediadrm media_rw sdcard_rw media system audio inet net_bt net_bt_admin net_bw_acct sdcard_r
     ioprio rt 4
     writepid /dev/cpuset/foreground/tasks
+    # cannon: this 32-bit HAL needs pre-A17 GraphicBufferMapper::lock (6 args).
+    # A17 linker dropped TARGET_LD_SHIM_LIBS, so preload the shim instead.
+    setenv LD_PRELOAD /vendor/lib/libshim_gbm_only.so
 
diff --git a/proprietary/vendor/etc/init/em_hidl_user.rc b/proprietary/vendor/etc/init/em_hidl_user.rc
index f4fc513..c8df55f 100644
--- a/proprietary/vendor/etc/init/em_hidl_user.rc
+++ b/proprietary/vendor/etc/init/em_hidl_user.rc
@@ -11,3 +11,9 @@ service emhidl_user /vendor/bin/em_hidl
     disabled
     user system
     group bluetooth radio gps system nfc
+
+# cannon: 本服务是 disabled，全树原本没有任何 trigger 显式 start 它，
+# 导致 vendor.mediatek.hardware.engineermode@1.x::IEmd 永不注册；
+# 走 EmUtils.getEmHidlService() 的 EM 菜单会在 onCreate 阻塞 5 s 后 ANR。
+on property:sys.boot_completed=1
+    start emhidl_user
