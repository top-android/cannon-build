diff --git a/server/BandwidthController.cpp b/server/BandwidthController.cpp
index 8a96738..93f7e1f 100644
--- a/server/BandwidthController.cpp
+++ b/server/BandwidthController.cpp
@@ -200,7 +200,42 @@ static const uint32_t uidBillingMask = Fwmark::getUidBillingMask();
  * See go/ipsec-data-accounting for more information.
  */
 
+/*
+ * [cannon][A17] 4.14 内核上没有可用的 xt_bpf pinned 程序。
+ *
+ * bpfloader 在本机 SIGABRT（4.14 缺 netd_skfilter 所需的 map/prog 类型），
+ * 所以 /sys/fs/bpf/netd_shared/prog_netd_skfilter_* 全都不存在。而下面 4 条
+ * `-m bpf --object-pinned` 规则会让 iptables-restore 整批失败：
+ *     ip6tables-restore v1.8.11 (legacy): bpf: failed to get bpf object
+ *     Error occurred at line: 169
+ * 于是 BandwidthController::enableBandwidthControl() 返回 EPERM，
+ * Controllers::init() 走 exit(2)，netd 无限重启（init.svc.netd=restarting），
+ * system_server 卡死在 StartNetworkManagementService 的 NetdService.get() 上，
+ * sys.boot_completed 永远不会置位。
+ *
+ * 处理方式和 NetdUpdatable 的「闸门降级」一致：pinned 程序缺失时只跳过这 4 条
+ * BPF 规则，其余记账/限速规则照常下发。代价是按 uid/iface 的 eBPF 记账失效
+ * （流量统计、data saver 的精确限速降级），但网络栈和开机流程可用。
+ */
+static bool xtBpfProgsAvailable() {
+    static const bool available = [] {
+        const char* const paths[] = {XT_BPF_ALLOWLIST_PROG_PATH, XT_BPF_DENYLIST_PROG_PATH,
+                                     XT_BPF_INGRESS_PROG_PATH, XT_BPF_EGRESS_PROG_PATH};
+        for (const char* p : paths) {
+            struct stat st;
+            if (stat(p, &st) != 0) {
+                ALOGW("[cannon] %s missing, skipping xt_bpf bandwidth rules "
+                      "(kernel 4.14 degrade)", p);
+                return false;
+            }
+        }
+        return true;
+    }();
+    return available;
+}
+
 std::vector<std::string> getBasicAccountingCommands() {
+    const bool useXtBpf = xtBpfProgsAvailable();
     // clang-format off
     std::vector<std::string> ipt_basic_accounting_commands = {
             "*filter",
@@ -213,11 +248,25 @@ std::vector<std::string> getBasicAccountingCommands() {
             StringPrintf("-A bw_INPUT -j MARK --or-mark 0x%x", uidBillingMask),
             "-A bw_OUTPUT -j bw_global_alert",
             "-A bw_costly_shared -j bw_penalty_box",
-            ("-I bw_penalty_box -m bpf --object-pinned " XT_BPF_DENYLIST_PROG_PATH " -j REJECT"),
+    };
+    // clang-format on
+    if (useXtBpf) {
+        ipt_basic_accounting_commands.push_back(
+                "-I bw_penalty_box -m bpf --object-pinned " XT_BPF_DENYLIST_PROG_PATH " -j REJECT");
+    }
+    // clang-format off
+    ipt_basic_accounting_commands.insert(ipt_basic_accounting_commands.end(), {
             "-A bw_penalty_box -j bw_happy_box",
             "-A bw_happy_box -j bw_data_saver",
             "-A bw_data_saver -j RETURN",
-            ("-I bw_happy_box -m bpf --object-pinned " XT_BPF_ALLOWLIST_PROG_PATH " -j RETURN"),
+    });
+    // clang-format on
+    if (useXtBpf) {
+        ipt_basic_accounting_commands.push_back(
+                "-I bw_happy_box -m bpf --object-pinned " XT_BPF_ALLOWLIST_PROG_PATH " -j RETURN");
+    }
+    // clang-format off
+    ipt_basic_accounting_commands.insert(ipt_basic_accounting_commands.end(), {
             "COMMIT",
 
             "*raw",
@@ -236,7 +285,14 @@ std::vector<std::string> getBasicAccountingCommands() {
             //
             // Hence we will never double count and additional corrections are not needed.
             // We can simply take the sum of base and stacked (+20B/pkt) interface counts.
-            ("-A bw_raw_PREROUTING -m bpf --object-pinned " XT_BPF_INGRESS_PROG_PATH),
+    });
+    // clang-format on
+    if (useXtBpf) {
+        ipt_basic_accounting_commands.push_back(
+                "-A bw_raw_PREROUTING -m bpf --object-pinned " XT_BPF_INGRESS_PROG_PATH);
+    }
+    // clang-format off
+    ipt_basic_accounting_commands.insert(ipt_basic_accounting_commands.end(), {
             "COMMIT",
 
             "*mangle",
@@ -249,9 +305,13 @@ std::vector<std::string> getBasicAccountingCommands() {
             // This is egress interface accounting: we account 464xlat traffic only on
             // the clat interface (as offloaded packets never hit base interface's ip6tables)
             // and later sum base and stacked with overhead (+20B/pkt) in higher layers
-            ("-A bw_mangle_POSTROUTING -m bpf --object-pinned " XT_BPF_EGRESS_PROG_PATH),
-            COMMIT_AND_CLOSE};
+    });
     // clang-format on
+    if (useXtBpf) {
+        ipt_basic_accounting_commands.push_back(
+                "-A bw_mangle_POSTROUTING -m bpf --object-pinned " XT_BPF_EGRESS_PROG_PATH);
+    }
+    ipt_basic_accounting_commands.push_back(COMMIT_AND_CLOSE);
     return ipt_basic_accounting_commands;
 }
 
