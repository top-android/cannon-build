diff --git a/build/soong/Android.bp b/build/soong/Android.bp
index 237f7aa..23ab3f6 100644
--- a/build/soong/Android.bp
+++ b/build/soong/Android.bp
@@ -46,8 +46,14 @@ lineage_generator {
 
     // Sources for dependency tracking
     dep_root: "$(TARGET_KERNEL_SOURCE)",
+    // [cannon][A17] 老式非 GKI 内核(4.14)走 make headers_install 分支，顶层 Makefile 会
+    // include scripts/Kbuild.include、scripts/Makefile.{kcov,gcc-plugins,kasan,extrawarn,ubsan}
+    // 及 arch/$(KERNEL_ARCH)/Makefile。这些必须在 sbox 沙箱内可见，否则 make 解析期即报
+    // "No such file or directory / No rule to make target"。故补 scripts/**/* 与 arch Makefile。
     dep_files: [
         "Makefile",
+        "scripts/**/*",
+        "arch/$(KERNEL_ARCH)/Makefile",
         "include/**/*",
         "arch/$(KERNEL_ARCH)/include/**/*",
         "techpack/audio/include/**/*",
diff --git a/tools/clean_headers.sh b/tools/clean_headers.sh
index 3a12160..178fd5b 100755
--- a/tools/clean_headers.sh
+++ b/tools/clean_headers.sh
@@ -3,7 +3,27 @@ set -eu
 
 export ANDROID_BUILD_TOP="$PWD"
 
-./bionic/libc/kernel/tools/clean_header.py -u \
+# [cannon][A17] generated_kernel_includes 的 make headers_install 在 sbox 沙箱（真 chroot）内执行，
+# 沙箱只含 kernel dep_files + tool_files，没有 bionic/。此脚本原本假定 cwd=AOSP 根、可直接调
+# ./bionic/libc/kernel/tools/clean_header.py；在沙箱内该路径不存在 → exit 127 使整条 rule 失败。
+# 由于 `make headers_install` 已由 scripts/Makefile.headersinst 做过 UAPI 清洗（去 __KERNEL__ 等），
+# clean_header.py 只是 Android 侧额外的小清洗，跳过不影响用户态编译。故：找得到就清洗，找不到就优雅跳过。
+CLEAN_HEADER=""
+for cand in \
+    "./bionic/libc/kernel/tools/clean_header.py" \
+    "${ANDROID_BUILD_TOP}/bionic/libc/kernel/tools/clean_header.py"; do
+    if [ -f "$cand" ]; then
+        CLEAN_HEADER="$cand"
+        break
+    fi
+done
+
+if [ -z "$CLEAN_HEADER" ]; then
+    echo "clean_headers.sh: clean_header.py not found (sbox/chroot without bionic); skip header post-clean for $1" >&2
+    exit 0
+fi
+
+python3 "$CLEAN_HEADER" -u \
     "$1/usr/include/asm/signal.h" \
     "$1/usr/include/asm-generic/signal.h" \
     "$1/usr/include/linux/eventpoll.h"
