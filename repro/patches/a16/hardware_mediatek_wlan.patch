+    SET_IF_NOT_NULL(fn, fln, wifi_set_country_code);
+    SET_IF_NOT_NULL(fn, fln, wifi_get_firmware_memory_dump);
+    SET_IF_NOT_NULL(fn, fln, wifi_set_log_handler);
