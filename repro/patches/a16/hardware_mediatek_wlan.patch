+    SET_IF_NOT_NULL(fn, fln, wifi_set_alert_handler);
+    SET_IF_NOT_NULL(fn, fln, wifi_reset_alert_handler);
+    SET_IF_NOT_NULL(fn, fln, wifi_get_firmware_version);
+    SET_IF_NOT_NULL(fn, fln, wifi_get_ring_buffers_status);
