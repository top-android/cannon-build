+//
+// SPDX-FileCopyrightText: 2024 The LineageOS Project
+//
+// SPDX-License-Identifier: Apache-2.0
+//
+
+cc_library_shared {
+    name: "libwifi-hal-wrapper",
+    vendor: true,
+    required: [
+        "libwifi-hal-wrapper.xml",
+    ],
+    srcs: [
+        "libwifi-hal.cpp",
+    ],
+    shared_libs: [
+        "libcutils",
+        "libutils",
+        "liblog",
+        "wifi_legacy",
+    ],
+    cflags: select(soong_config_variable("mediatek_wifi_hal", "use_pre_u_qpr2_struct"), {
+        true: ["-DUSE_PRE_U_QPR2_STRUCT"],
+        default: [],
+    }) + select(soong_config_variable("mediatek_wifi_hal", "use_pre_baklava_qpr0_struct"), {
+        true: ["-DUSE_PRE_BAKLAVA_QPR0_STRUCT"],
+        default: [],
+    }),
+}
+
+prebuilt_etc {
+    name: "libwifi-hal-wrapper.xml",
+    src: "libwifi-hal-wrapper.xml",
+    relative_install_path: "wifi/vendor_hals",
+    vendor: true,
+}
