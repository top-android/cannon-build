diff --git a/libshims/Android.bp b/libshims/Android.bp
index c365e16..b9f8918 100644
--- a/libshims/Android.bp
+++ b/libshims/Android.bp
@@ -104,3 +104,21 @@ cc_library_shared {
     ],
     compile_multilib: "64",
 }
+
+// 2026-11-01 A16：把 libnetutils 的 vendor 变体拉进 /vendor/lib64
+//
+// /vendor/bin/hw/tetheroffloadservice（A12 vendor blob）ELF NEEDED libnetutils.so，
+// 但 A16 重建 vendor 时没把它放进 /vendor/lib64（proprietary-files.txt 亦未登记）→
+// linker "library libnetutils.so not found" → HAL 起不来 → Tethering 无限等待
+// android.hardware.tetheroffload.config@1.0::IOffloadConfig/default（每次 1s 重试）→
+// startTethering 卡死 → 设置里开热点 ANR。
+//
+// 本模块本身是空壳，仅靠 shared_libs 依赖把 vendor_available:true 的 libnetutils
+// 以 vendor 变体编出来并装到 /vendor/lib64（顺带 /vendor/lib）。不改任何 blob。
+cc_library_shared {
+    name: "libnetutils_vendor_dep",
+    vendor: true,
+    srcs: ["src/netutils_dep_stub.c"],
+    shared_libs: ["libnetutils"],
+    compile_multilib: "both",
+}
diff --git a/libshims/src/netutils_dep_stub.c b/libshims/src/netutils_dep_stub.c
new file mode 100644
index 0000000..54e3dcd
--- /dev/null
+++ b/libshims/src/netutils_dep_stub.c
@@ -0,0 +1,8 @@
+// Intentionally trivial. This file exists only so that a vendor:true cc_library_shared
+// (libnetutils_vendor_dep) has at least one source, and via its shared_libs dependency
+// pulls the vendor variant of libnetutils into /vendor/lib64.
+//
+// Why: /vendor/bin/hw/tetheroffloadservice (A12 blob) has NEEDED libnetutils.so, but the
+// A16 vendor rebuild dropped it. Without it the HAL fails to link, never registers, and
+// Tethering blocks forever waiting for IOffloadConfig -> Settings ANR when enabling hotspot.
+void libnetutils_vendor_dep_anchor(void) {}
