+        // [cannon][A16] Arm the boot-time VoLTE re-apply workaround (see scheduleBootVolteReapply).
+        scheduleBootVolteReapply();
+    }
+
+    /**
+     * [cannon][A16][old-vendor-new-android] On cold boot the framework pushes the IMS capability
+     * config (changeMmTelCapability -> MtkMmTelFeature setFeatureValue) before MTK's legacy IMS
+     * carrier-config/ImsConfig subsystem is ready, so MTK ends up with "Voice:false" and stays
+     * OUT_OF_SERVICE. A manual VoLTE off->on re-pushes it once everything is ready and registers
+     * successfully. Replay that exact toggle once, a bit after carrier config is loaded, guarded so
+     * we never fight an already-registered state or a user-disabled VoLTE setting.
+     */
+    private void scheduleBootVolteReapply() {
+        if (mBootVolteReapplyArmed) {
+            return;
+        }
+        mBootVolteReapplyArmed = true;
+        postDelayed(this::bootVolteReapplyOnce, BOOT_VOLTE_REAPPLY_DELAY_MS);
+    }
+
+    private void bootVolteReapplyOnce() {
+        final ImsManager mgr = mImsManager;
+        if (mgr == null) {
+            return;
+        }
+        if (getPhone() != null && getPhone().getImsRegistrationTech() != -1) {
+            logi("bootVolteReapply: IMS already registered, skip");
+            return;
+        }
+        try {
+            if (!mgr.isEnhanced4gLteModeSettingEnabledByUser()) {
+                logi("bootVolteReapply: user VoLTE setting disabled, skip");
+                return;
+            }
+        } catch (Exception e) {
+            loge("bootVolteReapply: query user VoLTE setting failed: " + e);
+            return;
+        }
+        mBootVolteReapplyTries++;
+        logi("bootVolteReapply: replay VoLTE off->on to force MTK IMS registration, try="
+                + mBootVolteReapplyTries);
+        try {
+            mgr.setEnhanced4gLteModeSetting(false);
+        } catch (Exception e) {
+            loge("bootVolteReapply: setEnhanced4gLteModeSetting(false) failed: " + e);
+        }
+        postDelayed(() -> {
+            try {
+                mgr.setEnhanced4gLteModeSetting(true);
+            } catch (Exception e) {
+                loge("bootVolteReapply: setEnhanced4gLteModeSetting(true) failed: " + e);
+            }
+            postDelayed(() -> {
+                if (mBootVolteReapplyTries < 3
+                        && getPhone() != null
+                        && getPhone().getImsRegistrationTech() == -1) {
+                    bootVolteReapplyOnce();
+                } else {
+                    logi("bootVolteReapply: done, regTech="
+                            + (getPhone() == null ? "null" : getPhone().getImsRegistrationTech()));
+                }
+            }, BOOT_VOLTE_REAPPLY_RETRY_MS);
+        }, BOOT_VOLTE_REAPPLY_TOGGLE_GAP_MS);
     }
 
