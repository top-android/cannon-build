+    /**
+     * Converts an {@link ArrayList} of {@link Byte} into a primitive {@code byte[]}.
+     *
+     * <p>This helper existed up to Android 12 and was removed in Android 13/14. It is restored
+     * here because the prebuilt vendor IMS stack ({@code com.mediatek.ims}, built against
+     * Android 12) calls it statically and would otherwise die with {@code NoSuchMethodError}.
+     *
+     * @hide
+     */
+    public static byte[] arrayListToPrimitiveArray(ArrayList<Byte> bytes) {
+        byte[] ret = new byte[bytes.size()];
+        for (int i = 0; i < ret.length; i++) {
+            ret[i] = bytes.get(i);
+        }
+        return ret;
+    }
