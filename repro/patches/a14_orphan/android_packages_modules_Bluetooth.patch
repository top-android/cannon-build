+// 2026-10-27 cannon: 控制器用 Command Status 回应了一个"本该 Command Complete"的命令时
+// （MTK 对 HCI_Sniff_Subrating 0x811 回 UNSUPPORTED_REMOTE_OR_LMP_FEATURE 就是这种情况），
+// 原代码会造一个**空的** CommandCompleteView 交给回调，指望回调自己发现无效。
+// 但 main/shim/hci_layer.cc 的 OnTransmitPacketCommandComplete() 第一句就是
+// OpCodeText(view.GetCommandOpCode())，而 GetCommandOpCode() 里有 ASSERT(was_validated_)，
+// 于是直接 abort -> com.android.bluetooth 反复 SIGABRT 重启 -> 耳机反复断连重连。
+// 这里改成造一个**合法**的 Command Complete（真实 opcode + 真实错误状态），
+// legacy 层就能正常走失败分支。
+static CommandCompleteView make_error_command_complete(OpCode op_code, ErrorCode status) {
+  auto bytes = std::make_shared<std::vector<uint8_t>>(std::initializer_list<uint8_t>{
+      static_cast<uint8_t>(EventCode::COMMAND_COMPLETE),
+      0x04,  // parameter_total_size: num_hci_command_packets(1) + opcode(2) + status(1)
+      0x01,  // num_hci_command_packets
+      static_cast<uint8_t>(static_cast<uint16_t>(op_code) & 0xff),
+      static_cast<uint8_t>(static_cast<uint16_t>(op_code) >> 8),
+      static_cast<uint8_t>(status),
+  });
+  CommandCompleteView view =
+      CommandCompleteView::Create(EventView::Create(PacketView<kLittleEndian>(bytes)));
+  // 关键：was_validated_ 只有 IsValid() 会置真，而所有取值器（GetCommandOpCode 等）
+  // 第一句都是 ASSERT(was_validated_)。只造出格式正确的包而不校验，照样会断言。
+  if (!view.IsValid()) {
+    LOG_ERROR("Failed to build a valid error Command Complete for opcode 0x%04x",
+              static_cast<uint16_t>(op_code));
+  }
+  return view;
+}
