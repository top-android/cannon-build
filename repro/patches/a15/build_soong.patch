+// cannon(A15) fsgen fix: prebuilt modules synthesized from PRODUCT_COPY_FILES whose dest dir
+// is exactly "lib" or "lib64". The stock fsgen maps both dirs to
+// PrebuiltRenderScriptBitcodeFactory (MultilibBoth), which builds BOTH arm and arm64 variants
+// from a single src. When the same basename exists in both <part>/lib and <part>/lib64 (very
+// common for vendor blobs copied via PRODUCT_COPY_FILES), the arm64 variant of the "lib"
+// module and the arm64 variant of the "lib64" module both land at lib64/<name> ->
+// "packaging conflict" (and likewise at lib/<name>). Using MultilibCommon (a single
+// android_common variant, same pattern as PrebuiltAnyFactory) installs each copy verbatim
+// into exactly its literal dir, so no cross-arch duplication / conflict occurs. Because
+// Common.Multilib == "", installBaseDir keeps the literal base ("lib"/"lib64").
+func PrebuiltLibFactory() android.Module {
+	module := &PrebuiltEtc{}
+	InitPrebuiltEtcModule(module, "lib")
+	// This module is device-only
+	android.InitAndroidArchModule(module, android.DeviceSupported, android.MultilibCommon)
+	android.InitDefaultableModule(module)
+	return module
+}
+
+// prebuilt_lib64 installs verbatim into <partition>/lib64. See PrebuiltLibFactory.
+func PrebuiltLib64Factory() android.Module {
+	module := &PrebuiltEtc{}
+	InitPrebuiltEtcModule(module, "lib64")
+	// This module is device-only
+	android.InitAndroidArchModule(module, android.DeviceSupported, android.MultilibCommon)
+	android.InitDefaultableModule(module)
+	return module
+}
+
