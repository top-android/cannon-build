+                .set80211mcBasedIstaRoleSupported(TEST_80211MC_BASED_ISTA_ROLE_SUPPORTED)
+                .set80211mcBasedRstaRoleSupported(TEST_80211MC_BASED_RSTA_ROLE_SUPPORTED)
+                .setNtbIstaRoleSupported(TEST_NTB_ISTA_ROLE_SUPPORTED)
