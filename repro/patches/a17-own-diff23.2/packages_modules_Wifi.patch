+                .setNtbSecureLtfRangingSupported(TEST_NTB_SECURE_LTF_RANGING_SUPPORTED)
+                .setUnauthenticatedPasnModeSupported(TEST_UNAUTHENTICATED_PASN_MODE_SUPPORTED)
