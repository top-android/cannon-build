+        s_aware_if
+    )
+    s_dut.log.info('interfaceName = %s, ipv6=%s', s_aware_if, s_ipv6)
+
+    return (
+        pub_network_cap,
+        sub_network_cap,
+        p_aware_if,
+        s_aware_if,
+        p_ipv6,
+        s_ipv6,
+    )
