+        go_ip = wp2putils.p2p_go_ip(client_dut)
+        wp2putils.p2p_connection_ping_test(client_dut, go_ip)
+
+        # trigger disconnect
+        p2p_utils.remove_group_and_verify_disconnected(
+            device1, device2, is_group_negotiation=False
+        )
