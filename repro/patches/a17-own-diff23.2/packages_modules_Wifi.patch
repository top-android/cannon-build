+    private static final String TAG = "SupplicantP2pIfaceHalAidlMainlineImpl";
+    private static final String MAINLINE_SUPPLICANT_SERVICE_NAME = "wifi_mainline_supplicant";
+
+    private final WifiContext mWifiContext;
