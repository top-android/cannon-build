+                .setMeasurementChannelFrequencyMHz(5220)
+                .setMeasurementBandwidth(ScanResult.CHANNEL_WIDTH_80MHZ)
+                .build();
+
+        RangingResult rangingResult2 = new RangingResult.Builder()
