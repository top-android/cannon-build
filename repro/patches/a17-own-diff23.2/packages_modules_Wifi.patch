+}
diff --git a/aidl/mainline_supplicant/android/system/wifi/mainline_supplicant/NanDataPathSecurityConfig.aidl b/aidl/mainline_supplicant/android/system/wifi/mainline_supplicant/NanDataPathSecurityConfig.aidl
