+            mSendMgmtFrameExecutor = executor;
+            mSendMgmtFrameCallback = callback;
+            mWifiInjector.getWifiThreadRunner().getHandler()
+                    .postDelayed(mSendMgmtFrameTimeoutRunnable, SEND_MGMT_FRAME_TIMEOUT_MS);
+        }
+    }
