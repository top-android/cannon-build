+
+package android.net.wifi.rtt;
+
+import android.net.wifi.rtt.RangingResult;
+
+/**
+ * Interface for continuous RTT ranging result callback.
+ *
+ * @hide
+ */
+oneway interface IContinuousRangingResultCallback {
+    /**
+     * Service to manager callback indicating that the ranging operation failed to start.
+     */
+    void onRangingFailure(int code);
+
+    /**
+     * Service to manager callback providing periodic ranging results.
+     */
+    void onRangingResults(in List<RangingResult> results);
+
+    /**
+     * Service to manager callback indicating that the continuous ranging session has been stopped.
+     */
+    void onRangingStopped(int reason);
+}
