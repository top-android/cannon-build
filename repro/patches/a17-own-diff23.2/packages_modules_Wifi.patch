+            aware_avail = ad.wifi_aware_snippet.wifiAwareIsAvailable()
+            ad.wifi_aware_snippet.wifiAwareCloseAllWifiAwareSession()
+            if not aware_avail:
+                ad.log.info('Aware not available. Waiting ...')
+                state_handler = (
