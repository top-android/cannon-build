+
+                    Integer frequencyMhz =
+                            message.getAttributeValueAsInteger(NL80211_ATTR_WIPHY_FREQ);
+                    if (frequencyMhz == null) {
+                        Log.e(TAG, "Failed to get frequency from channel switch event");
