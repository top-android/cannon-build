diff --git a/aidl/mainline_supplicant/android/system/wifi/mainline_supplicant/NanRespondToDataPathIndicationRequest.aidl b/aidl/mainline_supplicant/android/system/wifi/mainline_supplicant/NanRespondToDataPathIndicationRequest.aidl
