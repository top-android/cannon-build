+    name: "feed_more_data_to_external_scorer"
+    is_exported: true
+    namespace: "wifi"
+    description: "Feed the L2/L3 data stall and pre-evaluation data to external scorer for reference"
+    bug: "446298612"
+}
+
+flag {
+    name: "mlo_link_speed_api"
+    is_exported: true
+    namespace: "wifi"
+    description: "API to get max supported Tx/Rx link speed for MLO links"
+    bug: "385329999"
+}
+
+flag {
+    name: "upgrade_single_6ghz_hotspot_to_dual_band"
+    namespace: "wifi"
+    description: "Add option to temporarily upgrade single 6ghz hotspot config to dual band if available"
+    bug: "394409845"
+}
+
+flag {
+    name: "multi_peer_aware_datapath"
+    namespace: "wifi"
+    is_exported: true
+    description: "new API to allow App create as many datapath as the NDP number from capability"
+    bug: "454343159"
+}
+
+flag {
+    name: "power_stats_api"
+    namespace: "wifi"
+    description: "API to get power statistics for each wifi core/radio"
+    bug: "444936941"
+}
+
+flag {
+    name: "allow_d2d_without_sta_on_xr"
+    is_exported: false
+    namespace: "wifi"
+    description: "Enables Standalone D2D on XR devices, even when STA+D2D concurrency is supported"
+    bug: "486996062"
+}
+
+flag {
+    name: "disable_insecure_wifi_autojoin_when_aapm_on"
+    namespace: "wifi"
+    description: "Android Advanced Protection Mode Feature: Disable Insecure Wifi Autojoin"
+    bug: "489845821"
+}
+
+flag {
+    name: "softap_traffic_monitor"
+    namespace: "wifi"
+    description: "Monitoring softap traffic stats and shut it down when there is no active packets "
+    bug: "475658391"
 }
 
 flag {
-    name: "ml_scorer_in_wifi_fw"
